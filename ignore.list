# shell globs matched against absolute paths, one per line
/var/lib/pacman/*
/var/cache/*
/var/log/*
/var/lib/systemd/*
/var/lib/NetworkManager/*
/var/.updated
/etc/.updated
/etc/machine-id
/etc/adjtime
/etc/*-
/etc/ssh/ssh_host_*
/etc/ld.so.cache
/etc/pacman.d/gnupg/*
/etc/ca-certificates/extracted/*
/etc/ssl/certs/*
/usr/lib/locale/locale-archive
/usr/share/mime/*
/usr/share/icons/*/icon-theme.cache
/usr/lib/modules/*/modules.*
/boot/initramfs-*
/boot/EFI/*
/boot/loader/random-seed
