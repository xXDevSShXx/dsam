# Maintainer: dsam
# dsam bootstraps tomli from this file: pkgver, source_x86_64 and sha256sums_x86_64 are read by `dsam fetch-tomli`.
pkgname=tomli-bin
pkgver=0.5.0
pkgrel=1
pkgdesc='Format-preserving command line tool to query and edit TOML files (upstream binary)'
arch=('x86_64')
url='https://github.com/blinxen/tomli'
license=('custom') # check the bundled LICENSE and replace with its SPDX id
depends=('glibc' 'gcc-libs')
provides=('tomli')
conflicts=('tomli')
source_x86_64=("$url/releases/download/$pkgver/tomli-$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('1678d3c6c7a7d055382c92bbd9424aacf9efe37d8c8ce9192dfe2b3e52ff53a7')

package() {
	install -Dm755 "$srcdir/tomli" "$pkgdir/usr/bin/tomli"
	install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
