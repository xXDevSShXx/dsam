#!/usr/bin/env bash
# dsam: DSam system manager. See `dsam help` and `dsam man`.
set -euo pipefail
export LC_ALL=C

VERSION=1.0.0
DRY=0
RC=0
DIFF_RC=0
DSAM_DIR=${DSAM_DIR:-$HOME/dsam}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/dsam
BASE_TOML="" PROFILE="" PROFILE_TOML=""

C1="" C0="" CE="" CW="" H1="" H0=""
if [[ -z ${NO_COLOR-} ]]; then
	if [[ -t 2 ]]; then
		C1=$'\e[1;38;2;190;85;230m' C0=$'\e[0m' CE=$'\e[1;31m' CW=$'\e[33m'
	fi
	if [[ -t 1 ]]; then
		H1=$'\e[1;38;2;190;85;230m' H0=$'\e[0m'
	fi
fi

msg()  { printf '%s\n' "$*" >&2; }
step() { printf '%s==>%s %s\n' "$C1" "$C0" "$*" >&2; }
warn() { printf '%swarning:%s %s\n' "$CW" "$C0" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$CE" "$C0" "$*" >&2; exit 1; }
need() { local c; for c; do command -v "$c" >/dev/null 2>&1 || die "missing dependency: $c"; done; }
run()  { if ((DRY)); then printf '%s[dry]%s %s\n' "$CW" "$C0" "$*" >&2; else "$@"; fi; }
lines() { if [[ -n $1 ]]; then printf '%s\n' "$1"; fi; }
has()  { grep -xF -- "$1" >/dev/null; }

guard() {
	if ((EUID == 0)) || [[ -n ${SUDO_USER-}${DOAS_USER-} ]]; then
		die "run dsam as your normal user; it calls doas where needed"
	fi
}

# ---------------------------------------------------------------- tomli

fetch_tomli() {
	local pb=$DSAM_DIR/packages/tomli-bin/PKGBUILD bin=$CACHE/bin src sum url tmp
	[[ -f $pb ]] || die "missing $pb"
	need curl tar sha256sum install
	read -r src sum < <(set +u; source "$pb"; printf '%s %s\n' "${source_x86_64[0]}" "${sha256sums_x86_64[0]}")
	url=${src#*::}
	tmp=$(mktemp -d)
	curl -fsSL "$url" -o "$tmp/t.tgz" || { rm -rf "$tmp"; die "download failed: $url"; }
	printf '%s  %s\n' "$sum" "$tmp/t.tgz" | sha256sum -c --status - || { rm -rf "$tmp"; die "sha256 mismatch: $url"; }
	tar -xzf "$tmp/t.tgz" -C "$tmp" tomli
	mkdir -p "$bin"
	install -m755 "$tmp/tomli" "$bin/tomli"
	rm -rf "$tmp"
	printf '%s\n' "$bin/tomli"
}

ensure_tomli() {
	if command -v tomli >/dev/null 2>&1; then
		rm -f "$CACHE/bin/tomli"
		return 0
	fi
	if [[ ! -x $CACHE/bin/tomli ]]; then
		step "fetching tomli (pinned in packages/tomli-bin/PKGBUILD)"
		fetch_tomli >/dev/null
	fi
	PATH=$CACHE/bin:$PATH
}

# all strings of an array key, one per line (empty if the key is missing)
tlist() { { tomli query -f "$1" "$2" 2>/dev/null || true; } | { grep -o '"[^"]*"' || true; } | sed 's/^"//; s/"$//'; }

# rewrite `key = [...]` inside [table] ("" = top level) with the contents of blockfile
awk_replace() { # file table key blockfile
	awk -v table="$2" -v key="$3" -v blk="$4" '
		BEGIN { intable = (table == "") }
		skip { if ($0 ~ /\]/) skip = 0; next }
		/^[ \t]*\[[^]]+\][ \t]*(#.*)?$/ {
			t = $0; sub(/^[ \t]*\[/, "", t); sub(/\][ \t]*(#.*)?$/, "", t); intable = (t == table)
		}
		intable && !done && $0 ~ ("^[ \t]*" key "[ \t]*=[ \t]*\\[") {
			while ((getline l < blk) > 0) print l
			close(blk); done = 1
			if ($0 !~ /\]/) skip = 1
			next
		}
		{ print }
		END { exit done ? 0 : 3 }
	' "$1"
}

# ---------------------------------------------------------------- repo

load_repo() {
	[[ -d $DSAM_DIR/packages ]] || die "not a dsam repo: $DSAM_DIR (set DSAM_DIR)"
	BASE_TOML=$DSAM_DIR/base.toml
	[[ -r $BASE_TOML ]] || die "missing $BASE_TOML"
	[[ -r /etc/dsam/profile ]] || die "no active profile: write its name to /etc/dsam/profile"
	PROFILE=$(tr -d '[:space:]' </etc/dsam/profile)
	PROFILE_TOML=$DSAM_DIR/profiles/$PROFILE/profile.toml
	[[ -r $PROFILE_TOML ]] || die "missing $PROFILE_TOML"
	ensure_tomli
}

ensure_paru_repo() {
	if ((DRY)); then return 0; fi
	local conf=${PARU_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/paru/paru.conf} want=$DSAM_DIR/packages
	if [[ ! -e $conf ]]; then
		mkdir -p "${conf%/*}"
		if [[ -r /etc/paru.conf ]]; then cp /etc/paru.conf "$conf"; else : >"$conf"; fi
	fi
	if grep -x '\[dsam\]' "$conf" >/dev/null; then
		grep -xF "Path = $want" "$conf" >/dev/null || warn "[dsam] in $conf does not point at $want"
	else
		printf '\n[dsam]\nPath = %s\nGenerateSrcinfo\n' "$want" >>"$conf"
		msg "added [dsam] PKGBUILD repo to $conf"
	fi
	return 0
}

declared_raw() { tlist "$BASE_TOML" packages; tlist "$PROFILE_TOML" packages.list; }

# declared names with groups expanded to their members, sorted
declared() {
	local x m
	while read -r x; do
		[[ -n $x ]] || continue
		m=$(pacman -Sgq "$x" 2>/dev/null || true)
		if [[ -n $m ]]; then printf '%s\n' "$m"; else printf '%s\n' "$x"; fi
	done < <(declared_raw) | sort -u
}

add_declared() {
	local p=$1 blk tmp
	if declared_raw | has "$p"; then return 0; fi
	if ((DRY)); then msg "[dry] would add $p to $PROFILE_TOML"; return 0; fi
	blk=$(mktemp) tmp=$(mktemp)
	{ tlist "$PROFILE_TOML" packages.list; printf '%s\n' "$p"; } | sort -u |
		awk 'BEGIN { print "list = [" } { printf "  \"%s\",\n", $0 } END { print "]" }' >"$blk"
	awk_replace "$PROFILE_TOML" packages list "$blk" >"$tmp" ||
		{ rm -f "$blk" "$tmp"; die "cannot record $p: no [packages] list = [...] in $PROFILE_TOML"; }
	if ! tlist "$tmp" packages.list | has "$p"; then
		rm -f "$blk" "$tmp"
		die "refusing to write $PROFILE_TOML: result failed verification"
	fi
	cat "$tmp" >"$PROFILE_TOML"
	rm -f "$blk" "$tmp"
	msg "recorded $p in profile '$PROFILE'"
}

# ---------------------------------------------------------------- custom packages

is_custom() { [[ -f $DSAM_DIR/packages/$1/PKGBUILD ]]; }
inst_ver()  { pacman -Q "$1" 2>/dev/null | cut -d' ' -f2 || true; }

# [epoch:]pkgver-pkgrel of a custom package, or "?" for VCS packages (pkgver() function)
pb_ver() (
	set +u
	cd "$DSAM_DIR/packages/$1"
	source ./PKGBUILD
	if declare -F pkgver >/dev/null; then echo "?"; exit 0; fi
	v=$pkgver-${pkgrel:-1}
	if [[ ${epoch:-0} != 0 ]]; then v=$epoch:$v; fi
	echo "$v"
)

link_dotfiles() {
	local d=$DSAM_DIR/packages/$1
	[[ -d $d/.dotfiles ]] || return 0
	need stow
	if ((DRY)); then
		stow -n -v --no-folding -d "$d" -t "$HOME" .dotfiles 2>&1 | sed 's/^/  /' >&2 || true
	else
		stow --no-folding -d "$d" -t "$HOME" .dotfiles ||
			die "$1: dotfile conflict (a real file already exists in \$HOME?); move it away and rerun"
	fi
	return 0
}

post_install() {
	local d=$DSAM_DIR/packages/$1
	[[ -f $d/post-install.sh ]] || return 0
	step "$1: post-install.sh"
	(cd "$d" && run bash ./post-install.sh) || { warn "$1: post-install.sh failed"; RC=1; }
	return 0
}

custom_apply() { # name [installed-version-before]
	local p=$1 pre iv rv act ch=0
	pre=${2-$(inst_ver "$p")}
	iv=$(inst_ver "$p")
	rv=$(pb_ver "$p")
	if [[ -z $iv ]]; then act=install
	elif [[ $rv == '?' ]]; then act=current
	else
		case $(vercmp "$rv" "$iv") in
			1) act=upgrade ;;
			0) act=current ;;
			*) act=downgrade ;;
		esac
	fi
	case $act in
		install | upgrade | downgrade)
			step "$p: $act ${iv:+$iv -> }$rv"
			if [[ $act == downgrade ]]; then warn "$p: downgrade; 'paru -Syu' would skip this, installing explicitly"; fi
			run paru -S "$p"
			;;
		current) msg "$p: up to date (${iv:-?})" ;;
	esac
	link_dotfiles "$p"
	if ((DRY)); then
		if [[ $act != current ]]; then ch=1; fi
	elif [[ $(inst_ver "$p") != "$pre" ]]; then
		ch=1
	fi
	if ((ch)); then post_install "$p"; fi
	return 0
}

installed_customs() {
	local d p
	for d in "$DSAM_DIR"/packages/*/PKGBUILD; do
		[[ -e $d ]] || continue
		p=${d%/PKGBUILD}; p=${p##*/}
		if [[ -n $(inst_ver "$p") ]]; then printf '%s\n' "$p"; fi
	done
}

# ---------------------------------------------------------------- commands

cmd_install() {
	load_repo; need paru pacman vercmp; ensure_paru_repo
	local pkgs=("$@") p
	if ((${#pkgs[@]} == 0)); then
		mapfile -t pkgs < <(comm -23 <(declared) <(pacman -Qq | sort -u))
		if ((${#pkgs[@]} == 0)); then msg "nothing to install: every declared package is present"; return 0; fi
	fi
	for p in "${pkgs[@]}"; do
		if is_custom "$p"; then
			custom_apply "$p"
		else
			step "$p"
			run paru -S "$p"
		fi
		if ((DRY)); then
			add_declared "$p"
		elif pacman -Qq "$p" >/dev/null 2>&1 || [[ -n $(pacman -Qqg "$p" 2>/dev/null || true) ]]; then
			add_declared "$p"
		else
			warn "$p is not an installed package name; not recorded in the profile"
		fi
	done
	return 0
}

cmd_update() {
	load_repo; need paru pacman vercmp; ensure_paru_repo
	local ign p args=()
	declare -A pre=()
	local customs=()
	ign=$(tlist "$PROFILE_TOML" packages.ignore | paste -sd,)
	if [[ -n $ign ]]; then args=(--ignore "$ign"); fi
	mapfile -t customs < <(installed_customs)
	for p in "${customs[@]}"; do pre[$p]=$(inst_ver "$p"); done
	step "paru -Syu${ign:+ (ignoring $ign)}"
	run paru -Syu "${args[@]}"
	for p in "${customs[@]}"; do custom_apply "$p" "${pre[$p]}"; done
	return "$RC"
}

cmd_config() {
	load_repo; need pacman
	ensure_paru_repo
	local p s
	while read -r p; do
		[[ -n $p ]] || continue
		link_dotfiles "$p"
	done < <(installed_customs)
	while read -r s; do
		[[ -n $s ]] || continue
		if systemctl is-enabled --quiet "$s" 2>/dev/null && systemctl is-active --quiet "$s" 2>/dev/null; then
			msg "service $s: enabled and active"
		else
			need doas systemctl
			step "service $s: enable --now"
			run doas systemctl enable --now "$s"
		fi
	done < <(tlist "$PROFILE_TOML" services.enable)
	return "$RC"
}

sect() { # title, newline-separated names
	[[ -n $2 ]] || return 0
	printf '%s%s%s\n' "$H1" "$1" "$H0"
	sed 's/^/  /' <<<"$2"
	DIFF_RC=1
}

cmd_diff() {
	local deps=0 dec inst expl miss extra asdep orph stray="" clo x
	if [[ ${1-} == --deps ]]; then deps=1; elif (($# > 0)); then die "usage: dsam diff [--deps]"; fi
	load_repo; need pacman
	dec=$(declared)
	inst=$(pacman -Qq | sort -u)
	expl=$({ pacman -Qqe || true; } | sort -u)
	miss=$(comm -23 <(lines "$dec") <(lines "$inst"))
	extra=$(comm -13 <(lines "$dec") <(lines "$expl"))
	asdep=$(comm -12 <(lines "$dec") <({ pacman -Qqd || true; } | sort -u))
	orph=$({ pacman -Qqdtt || true; } | sort -u)
	if ((deps)); then
		need pactree
		clo=$(comm -12 <(lines "$dec") <(lines "$inst") |
			while read -r x; do pactree -u "$x" 2>/dev/null || true; done | sort -u)
		stray=$(comm -23 <({ pacman -Qqd || true; } | sort -u) <(lines "$clo") | comm -23 - <(lines "$orph"))
	fi
	sect "missing (declared, not installed)" "$miss"
	sect "extra (explicitly installed, not declared)" "$extra"
	sect "declared but installed as dependency (pacman -D --asexplicit)" "$asdep"
	sect "orphans (dependencies nothing requires)" "$orph"
	sect "stray dependencies (not required by any declared package)" "$stray"
	if ((DIFF_RC)); then return 1; fi
	printf 'in sync (%s declared packages)\n' "$(lines "$dec" | wc -l)"
}

info_pkg() {
	local p=$1 v cls src req
	v=$(inst_ver "$p")
	printf 'package:   %s\n' "$p"
	if [[ -z $v ]]; then
		printf 'installed: no\n'
		if declared_raw | has "$p"; then printf 'declared:  yes\n'; else printf 'declared:  no\n'; fi
		if is_custom "$p"; then printf 'source:    custom (packages/%s)\n' "$p"; fi
		return 0
	fi
	if tlist "$BASE_TOML" packages | has "$p"; then cls="first-class (base)"
	elif tlist "$PROFILE_TOML" packages.list | has "$p"; then cls="first-class (profile $PROFILE)"
	elif { pacman -Qqd || true; } | has "$p"; then cls="second-class (installed as dependency)"
	else cls="undeclared (explicitly installed)"; fi
	if is_custom "$p"; then src="custom (packages/$p)"
	elif { pacman -Qqn || true; } | has "$p"; then src="repository"
	else src="foreign (AUR or other)"; fi
	req=$(pacman -Qi "$p" | sed -n 's/^Required By *: *//p')
	printf 'version:   %s\nclass:     %s\nsource:    %s\nrequired by: %s\n' "$v" "$cls" "$src" "$req"
}

info_path() {
	local p link own pkg kind
	p=$(realpath -ms -- "$1")
	printf 'path:      %s\n' "$p"
	if [[ -L $p ]]; then
		link=$(readlink -f -- "$p")
		case $link in
			"$DSAM_DIR"/packages/*/.dotfiles/*)
				pkg=${link#"$DSAM_DIR"/packages/}; pkg=${pkg%%/*}
				printf 'type:      dotfile\nowner:     %s (dsam custom package, linked by stow)\n' "$pkg"
				return 0 ;;
		esac
	fi
	if own=$(pacman -Qo -- "$p" 2>/dev/null); then
		printf 'type:      package-owned\nowner:     %s\n' "${own##* is owned by }"
		return 0
	fi
	case $p in
		/etc/* | "$HOME"/.config/*) kind=config ;;
		"$HOME"/*) kind="user data" ;;
		*) kind="system file" ;;
	esac
	printf 'type:      %s\nowner:     none (not owned by any package)\n' "$kind"
}

cmd_info() {
	(($# == 1)) || die "usage: dsam info <package|path>"
	load_repo; need pacman
	case $1 in
		*/* | .*) info_path "$1" ;;
		*) info_pkg "$1" ;;
	esac
}

# ---------------------------------------------------------------- help

topics() { roff | awk '/^\.SH/ { s = $0; sub(/^\.SH +/, "", s); gsub(/"/, "", s); print tolower(s) }'; }

usage() {
	cat <<EOF
dsam $VERSION: DSam system manager

usage: dsam [-n] <command> [args]
  install [pkg...]   install packages; no args: everything declared but missing
  update             paru -Syu, then reconcile custom packages
  config             link dotfiles of custom packages, enable services
  diff [--deps]      declared vs installed packages (exit 1 if they differ)
  info <pkg|path>    class and source of a package, or the owner of a path
  fetch-tomli        download the pinned tomli binary and print its path
  man [--install]    full manual (--install writes dsam(1) system-wide)
  help [topic]       one manual section: $(topics | paste -sd' ')
  -n, --dry-run      show what install/update/config would do
EOF
}

cmd_help() {
	if (($# == 0)); then usage; return 0; fi
	need man
	local f
	f=$(mktemp)
	roff | awk -v t="${1^^}" '
		/^\.TH/ { print; next }
		/^\.SH/ { s = $0; sub(/^\.SH +/, "", s); gsub(/"/, "", s); on = (toupper(s) == t) }
		on { print; found = 1 }
		END { exit !found }
	' >"$f" || { rm -f "$f"; die "no such topic: $1 (topics: $(topics | paste -sd' '))"; }
	man -l "$f"
	rm -f "$f"
}

cmd_man() {
	need man
	local f
	f=$(mktemp)
	roff >"$f"
	if [[ ${1-} == --install ]]; then
		need doas install
		run doas install -Dm644 "$f" /usr/share/man/man1/dsam.1
	else
		man -l "$f"
	fi
	rm -f "$f"
}

roff() {
	cat <<'ROFF'
.TH DSAM 1 "2026-10" "dsam 1.0.0" "DSam"
.SH NAME
dsam \- DSam system manager: declared packages, custom PKGBUILDs, dotfiles, services
.SH SYNOPSIS
.nf
\fBdsam\fR [\fB\-n\fR] \fBinstall\fR [\fIpackage\fR...]
\fBdsam\fR [\fB\-n\fR] \fBupdate\fR
\fBdsam\fR [\fB\-n\fR] \fBconfig\fR
\fBdsam\fR \fBdiff\fR [\fB\-\-deps\fR]
\fBdsam\fR \fBinfo\fR \fIpackage\fR|\fIpath\fR
\fBdsam\fR \fBhelp\fR [\fItopic\fR]   \fBdsam\fR \fBman\fR [\fB\-\-install\fR]   \fBdsam\fR \fBfetch\-tomli\fR
.fi
.SH DESCRIPTION
dsam keeps an Arch Linux system in line with two TOML files kept in a git repository: a base package list and a per\-machine profile.
It does not reimplement anything: packages go through \fBparu\fR(8), dotfiles through \fBstow\fR(8), services through \fBsystemctl\fR(1), TOML through \fBtomli\fR.
It never touches /etc (apart from enabling services and the optional man page install).
Run it as your normal user; it calls \fBdoas\fR where root is needed and refuses to run as root or under sudo/doas.
.PP
Terms: a \fIfirst\-class\fR package is one you listed (base.toml or the profile). A \fIsecond\-class\fR package is a dependency pulled in by something else.
A \fIcustom\fR package is one with a PKGBUILD in the repo's packages/ directory.
.SH COMMANDS
.TP
.B install [package...]
For each package: if packages/<name>/PKGBUILD exists it is a custom package, otherwise it is passed to paru (repositories and AUR).
After a successful install the name is added, sorted and deduplicated, to \fB[packages] list\fR of the active profile.
With no arguments, installs everything declared but missing (use this on a fresh system).
.TP
.B update
Runs \fBparu \-Syu\fR with the profile's \fB[packages] ignore\fR list, then reconciles every installed custom package: version change since before the update triggers post\-install.sh, a PKGBUILD older than the installed version is installed explicitly (downgrade), dotfiles are relinked.
.TP
.B config
Relinks the dotfiles of every installed custom package and enables (\fBsystemctl enable \-\-now\fR) each unit in \fB[services] enable\fR that is not already enabled and active.
.TP
.B diff [\-\-deps]
Compares what is installed with what is declared. See \fBDIFF\fR. Exit status 1 when anything differs.
.TP
.B info package
Version, class (base, profile, dependency, undeclared), source (custom, repository, foreign) and what requires it.
.TP
.B info path
Which package owns the file (\fBpacman \-Qo\fR). Paths linked by stow from a custom package report that package. A path is anything containing a slash or starting with a dot.
.TP
.B fetch\-tomli
Downloads the tomli release pinned in packages/tomli\-bin/PKGBUILD, verifies its sha256, stores it in the cache directory and prints its path. Allowed as root so that base.sh can use it. Other commands do this automatically when tomli is not in PATH.
.TP
.B \-n, \-\-dry\-run
For install, update and config: print the commands that would run (paru, stow \-n, doas, post\-install.sh) without running them or editing any file.
.SH LAYOUT
.nf
/etc/dsam/profile                 one line: the active profile name
$DSAM_DIR/base.toml               packages every machine gets
$DSAM_DIR/profiles/<name>/profile.toml
$DSAM_DIR/packages/<name>/PKGBUILD         custom package (required)
$DSAM_DIR/packages/<name>/post\-install.sh  optional
$DSAM_DIR/packages/<name>/.dotfiles/       optional, mirrors $HOME
.fi
.SH TOML
dsam reads TOML with \fBtomli query\fR. Write strings with double quotes. The only file dsam writes is profile.toml, and only the \fBlist\fR array (rewritten one element per line, sorted; comments inside that array are lost). The result is re\-parsed before it replaces the file.
.PP
base.toml:
.nf
packages = [
  "base",
  "linux",
  "base\-devel",   # groups are expanded to their members
]
.fi
.PP
profiles/<name>/profile.toml:
.nf
[machine]            # read by base.sh, ignored by dsam
swap = "zram"

[packages]
list = [
  "helix",
]
ignore = ["linux\-firmware"]   # passed to paru \-Syu \-\-ignore

[services]
enable = ["NetworkManager.service"]
.fi
.PP
Keys that are absent count as empty. \fBlist\fR must exist for \fBinstall\fR to record packages.
.SH PACKAGES
.SS Creating a package
.nf
mkdir $DSAM_DIR/packages/foo
$EDITOR $DSAM_DIR/packages/foo/PKGBUILD   # pkgname must equal the directory name
dsam install foo
.fi
dsam adds a \fB[dsam]\fR PKGBUILD repository (\fBPath = $DSAM_DIR/packages\fR, \fBGenerateSrcinfo\fR) to paru's config on first use, so paru builds the package, resolves its dependencies (including AUR ones) and installs it. If the user paru.conf does not exist yet it is created as a copy of /etc/paru.conf. PKGBUILD repositories with Path are not reviewed by paru.
.PP
For \-bin packages: if upstream CI already builds a native .pkg.tar.zst, use it as the source and make package() copy usr/; otherwise download the release binary, verify its checksum and install it.
.SS Maintaining a package
Bump \fBpkgver\fR (reset \fBpkgrel\fR to 1) or \fBpkgrel\fR, update the checksums, run \fBdsam update\fR. dsam compares the PKGBUILD's [epoch:]pkgver\-pkgrel with the installed version using vercmp(8): higher means upgrade, lower means downgrade, equal means nothing. Lowering a version on purpose is how you roll back.
.PP
\fBpost\-install.sh\fR runs as your user, with the package directory as working directory, after an install, upgrade or downgrade, never when the version is unchanged. Keep it idempotent.
.PP
VCS packages (a pkgver() function) have no version dsam can know without building; dsam leaves their upgrades to \fBparu \-Syu \-\-devel\fR and only relinks their dotfiles.
.SS Removing a package
Uninstall it (\fBparu \-Rns name\fR), delete its line from the profile list, and for a custom package delete its directory (unlink its dotfiles first: \fBstow \-D \-d packages/name \-t ~ .dotfiles\fR). dsam has no remove command on purpose.
.SH DOTFILES
Files under packages/<name>/.dotfiles/ mirror $HOME and are symlinked with \fBstow \-\-no\-folding\fR, so every file gets its own symlink and programs writing next to their config do not write into the repository. If a real file already exists at a target, stow aborts and dsam stops with an error: move the file away (or into .dotfiles/) and rerun. \fBdsam \-n config\fR shows the links without making them.
.SH DIFF
No cache is kept; everything comes from pacman's local database.
.TP
.B missing
declared (groups expanded) but not installed.
.TP
.B extra
explicitly installed but not declared: either declare it or remove it.
.TP
.B declared but installed as dependency
fix with \fBpacman \-D \-\-asexplicit name\fR so removing its dependent does not remove it.
.TP
.B orphans
dependencies nothing requires (\fBpacman \-Qqdtt\fR).
.TP
.B stray dependencies
only with \fB\-\-deps\fR (needs pactree from pacman\-contrib): dependencies not reachable from any declared package, e.g. those pulled in by extras.
.PP
Files are deliberately out of scope: use \fBdsam info path\fR to ask who owns a file.
.SH ENVIRONMENT
.TP
.B DSAM_DIR
repository path (default ~/dsam).
.TP
.B XDG_CACHE_HOME, XDG_CONFIG_HOME, PARU_CONF
cache for the fetched tomli (~/.cache/dsam/bin), and paru's configuration file location.
.TP
.B NO_COLOR
disables colour. Colour is only used on terminals.
.SH CAVEATS
.IP \(bu 2
Downgrading through paru's PKGBUILD repository has not been verified against every paru version; if \fBdsam update\fR reports a downgrade and the installed version does not change, run \fBparu \-S name\fR yourself and check the output.
.IP \(bu 2
Package directory name, pkgname and the name pacman knows must be identical.
.IP \(bu 2
Package names with provides (installing "jack" satisfied by another package) are not recorded in the profile; dsam warns.
.IP \(bu 2
tomli's command line is documented by its authors as unstable; the version and sha256 are pinned in packages/tomli\-bin/PKGBUILD, the single source for both the package and the bootstrap download.
.SH EXAMPLES
.nf
dsam install                  # fresh system: install everything declared
dsam install helix ripgrep    # install and record in the profile
dsam \-n update                # preview an update
dsam diff \-\-deps              # what drifted?
dsam info ~/.cargo/config.toml
dsam info sway
dsam help packages            # just the PACKAGES section
.fi
ROFF
}

main() {
	local a args=()
	for a in "$@"; do
		case $a in
			-n | --dry-run) DRY=1 ;;
			*) args+=("$a") ;;
		esac
	done
	set -- "${args[@]}"
	local cmd=${1-help}
	shift || true
	case $cmd in
		help | -h | --help) cmd_help "$@" ;;
		man) cmd_man "$@" ;;
		version | -V | --version) echo "dsam $VERSION" ;;
		fetch-tomli) fetch_tomli ;;
		install | update | config | diff | info) guard; "cmd_$cmd" "$@" ;;
		*) die "unknown command: $cmd (try: dsam help)" ;;
	esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
