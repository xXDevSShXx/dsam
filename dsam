#!/bin/sh
# usage: dsam <install|update|config|diff|info|track|ignore> [args]
#   install <pkg>...   install or sync packages, record them in the profile's packages.txt;
#                      a packages/<pkg> already installed is rebuilt when its PKGBUILD
#                      version differs (up or down) and its .dotfiles are re-linked
#   update [-i a,b]    paru -Syu (fails if it does not finish), then sync packages/ ones;
#                      held packages: -i flag and profiles/<profile>/ignore-packages.txt
#   config             deploy tracked files, then run configure.sh
#   diff [-d] [-u]     drift report; -d dependencies, -u unowned files
#   info <pkg|path>    class of a package, or type and owner of a file
#   track <file>       copy an unowned system file into the profile and deploy it from there
#   ignore <glob>...   accept unowned paths
set -eu
export LC_ALL=C

here=$(dirname "$(readlink -f "$0")")
# shellcheck disable=SC1091
. "$here/lib.sh"
refuse_root

tab=$(printf '\t')
kv() { printf '%-12s %s\n' "$1" "$2"; }
has() { grep -qxF -- "$1" "$2"; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

profile=${DSAM_PROFILE:-$(cat /etc/dsam/profile 2>/dev/null || true)}
[ -n "$profile" ] || die "no active profile (/etc/dsam/profile)"
pdir=$here/profiles/$profile
[ -f "$pdir/profile.conf" ] || die "unknown profile: $profile"
# shellcheck disable=SC1091
. "$pdir/profile.conf"
manifest=$pdir/files.manifest

# ---------- shared state ----------

base_list() {
	{
		clean "$here/base-packages.txt"
		echo paru
		case $(awk -F': ' '/^vendor_id/ { print $2; exit }' /proc/cpuinfo) in
			GenuineIntel) echo intel-ucode ;;
			AuthenticAMD) echo amd-ucode ;;
		esac
		if [ "$SWAP" = zram ]; then echo zram-generator; fi
	} | sort -u
}

load_pkgs() {
	base_list > "$tmp/base"
	clean "$pdir/packages.txt" > "$tmp/first"
	sort -u "$tmp/base" "$tmp/first" > "$tmp/declared"
	pacman -Qq | sort -u > "$tmp/installed"
	pacman -Qqe | sort -u > "$tmp/explicit"
	pacman -Qqd | sort -u > "$tmp/deps"
	pacman -Qqdt | sort -u > "$tmp/orphans"
}

# expected symlinks from the .dotfiles of every declared package
load_links() {
	: > "$tmp/links"
	while IFS= read -r p; do
		src=$here/packages/$p/.dotfiles
		[ -d "$src" ] || continue
		(cd "$src" && find . \( -type f -o -type l \) | sed 's|^\./||') | while IFS= read -r f; do
			printf '%s\t%s\n' "$HOME/$f" "$src/$f"
		done >> "$tmp/links"
	done < "$tmp/declared"
	cut -f1 "$tmp/links" | sort -u > "$tmp/linkpaths"
}

load_ignore() {
	{ cat "$here/ignore.list" "$pdir/ignore.list" 2>/dev/null || true; } \
		| sed '/^[[:space:]]*\(#\|$\)/d' > "$tmp/ignore"
}

load_tracked() {
	if [ -f "$manifest" ]; then
		awk '/^[[:space:]]*(#|$)/ { next } { sub(/^[^ ]+ +[^ ]+ +/, ""); print }' "$manifest" \
			| sort -u > "$tmp/tracked"
	else
		: > "$tmp/tracked"
	fi
}

is_ignored() {
	while IFS= read -r pat; do
		# shellcheck disable=SC2254
		case $1 in $pat) return 0 ;; esac
	done < "$tmp/ignore"
	return 1
}

is_user_data() {
	case $1 in
		"$HOME"/.*) return 1 ;;
		"$HOME"/*) return 0 ;;
	esac
	return 1
}

pkg_class() {
	if has "$1" "$tmp/base"; then echo base
	elif has "$1" "$tmp/first"; then echo first
	elif has "$1" "$tmp/deps"; then echo second
	elif has "$1" "$tmp/explicit"; then echo untracked
	else echo none
	fi
}

# paths such as /boot are root-only, so fall back to doas when needed
exists() { [ -e "$1" ] || as_root test -e "$1" < /dev/null; }
meta() { stat -c '%a %U:%G' -- "$1" 2>/dev/null || as_root stat -c '%a %U:%G' -- "$1" < /dev/null; }
same() {
	if [ -r "$2" ]; then cmp -s "$1" "$2"; else as_root cmp -s "$1" "$2" < /dev/null; fi
}

# ---------- install / update ----------

cmd_install() {
	[ $# -ge 1 ] || die "usage: dsam install <package>..."
	load_pkgs
	pkg_install "$@"
	for p; do
		if has "$p" "$tmp/base" || clean "$pdir/packages.txt" | grep -qxF -- "$p"; then
			continue
		fi
		touch "$pdir/packages.txt"
		printf '%s\n' "$p" >> "$pdir/packages.txt"
	done
}

cmd_update() {
	: > "$tmp/hold"
	while [ $# -gt 0 ]; do
		case $1 in
			-i|--ignore)
				[ $# -ge 2 ] || die "update: $1 needs a package list"
				printf '%s\n' "$2" | tr ',' '\n' | sed '/^$/d' >> "$tmp/hold"
				shift ;;
			*) die "update: unknown option: $1" ;;
		esac
		shift
	done
	clean "$pdir/ignore-packages.txt" >> "$tmp/hold"
	sort -u "$tmp/hold" -o "$tmp/hold"
	hold=$(paste -sd, "$tmp/hold")

	load_pkgs
	sync_srcinfo
	say "system update"
	set -- -Syu
	if [ -n "$hold" ]; then set -- "$@" --ignore "$hold"; fi
	aur "$@" || die "paru -Syu did not finish, nothing else was updated; re-run once the network is fixed"

		say "package overlays and custom builds"
	while IFS= read -r p; do
		has_dir "$p" || continue
		if has "$p" "$tmp/hold"; then say "held: $p"; continue; fi
		sync_package "$p"
	done < "$tmp/declared"
}

# ---------- config ----------

cmdconfig()	if is_custom "$1"; then kv source: "packages/$1 (built)"
	elif has_dir "$1"; then kv source: "packages/$1 (dotfiles overlay)"
	fi:]]*(#|$)'
	 "$manifest" | while read -r mode own path; do
			as_root install -D -m "$mode" -o "${own%%:*}" -g "${own#*:}" \
				-- "$pdir/files$path" "$path" < /dev/null
		done
	fi
	if [ -x "$here/configure.sh" ]; then exec "$here/configure.sh" "$@"; fi
}

# ---------- diff ----------

diff_packages() {
	printf '== packages ==\n'
	comm -23 "$tmp/declared" "$tmp/installed" | sed 's/^/missing     /'
	comm -13 "$tmp/declared" "$tmp/explicit" | sed 's/^/untracked   /'
	if [ "$deps" -eq 1 ]; then
		comm -23 "$tmp/deps" "$tmp/orphans" | sed 's/^/dependency  /'
		sed 's/^/orphan      /' "$tmp/orphans"
	fi
}

diff_files() {
	printf '== tracked files ==\n'
	[ -f "$manifest" ] || return 0
	grep -Ev '^[[:space:]]*(#|$)' "$manifest" | while read -r mode own path; do
		if ! exists "$path"; then
			printf 'missing     %s\n' "$path"
		elif ! same "$pdir/files$path" "$path"; then
			printf 'modified    %s\n' "$path"
		elif [ "$(meta "$path")" != "${mode#0} $own" ]; then
			printf 'metadata    %s\n' "$path"
		fi
	done
}

diff_home() {
	printf '== home (.dotfiles links) ==\n'
	while IFS=$tab read -r link target; do
		if [ -L "$link" ] && [ "$(readlink -- "$link")" = "$target" ]; then continue; fi
		if [ -L "$link" ] || [ -e "$link" ]; then
			printf 'conflict    %s\n' "$link"
		else
			printf 'unlinked    %s\n' "$link"
		fi
	done < "$tmp/links"
}

diff_unowned() {
	printf '== unowned files ==\n'
	{ find / -xdev; as_root find /boot -xdev < /dev/null; } 2>/dev/null | sort -u > "$tmp/all"
	pacman -Qlq | sed 's:/$::' | sort -u > "$tmp/owned"
	comm -23 "$tmp/all" "$tmp/owned" | while IFS= read -r f; do
		[ "$f" != / ] || continue
		is_ignored "$f" && continue
		has "$f" "$tmp/tracked" && continue
		printf 'unknown     %s\n' "$f"
	done

	printf '== unowned files (home) ==\n'
	for e in "$HOME"/.[!.]*; do
		if [ -e "$e" ] || [ -L "$e" ]; then find "$e" \( -type f -o -type l \) 2>/dev/null; fi
	done | sort -u > "$tmp/home_all"
	while IFS= read -r f; do
		is_ignored "$f" && continue
		has "$f" "$tmp/linkpaths" && continue
		if [ -L "$f" ]; then
			case $(readlink -- "$f") in
				"$here"/packages/*) printf 'stale       %s\n' "$f"; continue ;;
			esac
		fi
		printf 'unknown     %s\n' "$f"
	done < "$tmp/home_all"
}

cmd_diff() {
	deps=0
	unowned=0
	for a; do
		case $a in
			-d|--deps) deps=1 ;;
			-u|--unowned) unowned=1 ;;
			*) die "diff: unknown option: $a" ;;
		esac
	done
	load_pkgs
	load_links
	load_ignore
	load_tracked
	diff_packages
	diff_files
	diff_home
	if [ "$unowned" -eq 1 ]; then diff_unowned; fi
}

# ---------- info ----------

info_pkg() {
	load_pkgs
	if pacman -Qq -- "$1" > /dev/null 2>&1; then inst=yes; else inst=no; fi
	kv package: "$1"
	kv installed: "$inst"
	if is_custom "$1"; then kv source: "packages/$1 (built)"
	elif has_dir "$1"; then kv source: "packages/$1 (dotfiles overlay)"
	fi
	case $(pkg_class "$1") in
		base) kv class: base ;;
		first) kv class: "first (packages.txt)" ;;
		second)
			kv class: "second (dependency)"
			kv required-by: "$(pacman -Qi -- "$1" | sed -n 's/^Required By *: *//p')"
			if has "$1" "$tmp/orphans"; then kv note: "orphan, nothing requires it"; fi
			;;
		untracked) kv class: "untracked (explicitly installed, not declared)" ;;
		none) kv class: "none (not installed, not declared)" ;;
	esac
}

info_file() {
	path=$(realpath -sm -- "$1")
	load_pkgs
	load_links
	load_ignore
	load_tracked
	owner=$(pacman -Qoq -- "$path" 2>/dev/null || true)
	if has "$path" "$tmp/tracked"; then type=config
	elif has "$path" "$tmp/linkpaths"; then type=config
	elif is_ignored "$path"; then type=ignored
	elif is_user_data "$path"; then type=user_data
	elif [ -n "$owner" ]; then type=owned
	else type=untracked
	fi
	kv path: "$path"
	kv type: "$type"
	kv owner: "${owner:-none}"
}

cmd_info() {
	[ $# -eq 1 ] || die "usage: dsam info <package|path>"
	case $1 in
		*/*|.*) info_file "$1" ;;
		*) info_pkg "$1" ;;
	esac
}

# ---------- track / ignore ----------

cmd_track() {
	[ $# -eq 1 ] || die "usage: dsam track <file>"
	path=$(readlink -f -- "$1")
	[ -f "$path" ] || die "not a regular file: $path"
	case $path in
		"$HOME"/*) die "home files belong in a package's .dotfiles: $path" ;;
		/etc/shadow*|/etc/gshadow*|/etc/ssh/ssh_host_*|/etc/NetworkManager/system-connections/*)
			die "refusing to track secrets: $path" ;;
	esac
	dest=$pdir/files$path
	mkdir -p "$(dirname "$dest")"
	as_root cat -- "$path" > "$dest"
	mode=$(stat -c '%a' -- "$path")
	own=$(stat -c '%U:%G' -- "$path")
	touch "$manifest"
	awk -v p="$path" '{ q = $0; sub(/^[^ ]+ +[^ ]+ +/, "", q); if (q != p) print }' "$manifest" > "$tmp/manifest"
	printf '%04d %s %s\n' "$mode" "$own" "$path" >> "$tmp/manifest"
	sort -k3 "$tmp/manifest" > "$manifest"
}

cmd_ignore() {
	[ $# -ge 1 ] || die "usage: dsam ignore <glob>..."
	touch "$here/ignore.list"
	for pat; do
		has "$pat" "$here/ignore.list" || printf '%s\n' "$pat" >> "$here/ignore.list"
	done
}

# ---------- dispatch ----------

cmd=${1:-}
if [ $# -gt 0 ]; then shift; fi
case $cmd in
	install) cmd_install "$@" ;;
	update) cmd_update "$@" ;;
	config) cmd_config "$@" ;;
	diff) cmd_diff "$@" ;;
	info) cmd_info "$@" ;;
	track) cmd_track "$@" ;;
	ignore) cmd_ignore "$@" ;;
	*) die "usage: dsam <install|update|config|diff|info|track|ignore> [args]" ;;
esac
exit "$DSAM_RC"
