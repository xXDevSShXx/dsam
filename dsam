# dsam: DSam system manager. See `dsam help` and `dsam man`.
set -euo pipefail
export LC_ALL=C

VERSION=1.0.0
DRY=0
RC=0
DIFF_RC=0
SELF=$(readlink -f -- "${BASH_SOURCE[0]}")
if [[ -z ${DSAM_DIR-} ]]; then
	DSAM_DIR=${SELF%/*}
	[[ -d $DSAM_DIR/packages ]] || DSAM_DIR=$HOME/dsam
fi
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/dsam
BASE_TOML="" PROFILE="" PROFILE_TOML=""

C1="" C0="" CE="" CW="" H1="" H0=""
if [[ -z ${NO_COLOR-} ]]; then
	if [[ -t 2 ]]; then
		C1=$'\e[1;38;2;190;85;230m' C0=$'\e[0m' CE=$'\e[1;31m' CW=$'\e[33m'
	fi
	if [[ -t 1 ]]; then
		H1=$'\e[1;38;2;190;85;230m' H0=$'\e[0m'
	fi
fi

msg()  { printf '%s\n' "$*" >&2; }
step() { printf '%s==>%s %s\n' "$C1" "$C0" "$*" >&2; }
warn() { printf '%swarning:%s %s\n' "$CW" "$C0" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$CE" "$C0" "$*" >&2; exit 1; }
need() { local c; for c; do command -v "$c" >/dev/null 2>&1 || die "missing dependency: $c"; done; }
run()  { if ((DRY)); then printf '%s[dry]%s %s\n' "$CW" "$C0" "$*" >&2; else "$@"; fi; }
lines() { if [[ -n $1 ]]; then printf '%s\n' "$1"; fi; }
has()  { grep -xF -- "$1" >/dev/null; }
aur()  { paru --sudo doas "$@"; }

guard() {
	if ((EUID == 0)) || [[ -n ${SUDO_USER-}${DOAS_USER-} ]]; then
		die "run dsam as your normal user; it calls doas where needed"
	fi
}

# ---------------------------------------------------------------- tomli

fetch_tomli() {
	local pb=$DSAM_DIR/packages/tomli-bin/PKGBUILD bin=$CACHE/bin src sum url tmp
	[[ -f $pb ]] || die "missing $pb"
	need curl tar sha256sum install
	read -r src sum < <(set +u; source "$pb"; printf '%s %s\n' "${source_x86_64[0]}" "${sha256sums_x86_64[0]}")
	url=${src#*::}
	tmp=$(mktemp -d)
	curl -fsSL "$url" -o "$tmp/t.tgz" || { rm -rf "$tmp"; die "download failed: $url"; }
	printf '%s  %s\n' "$sum" "$tmp/t.tgz" | sha256sum -c --status - || { rm -rf "$tmp"; die "sha256 mismatch: $url"; }
	tar -xzf "$tmp/t.tgz" -C "$tmp" tomli
	mkdir -p "$bin"
	install -m755 "$tmp/tomli" "$bin/tomli"
	rm -rf "$tmp"
	printf '%s\n' "$bin/tomli"
}

ensure_tomli() {
	if command -v tomli >/dev/null 2>&1; then
		rm -f "$CACHE/bin/tomli"
		return 0
	fi
	if [[ ! -x $CACHE/bin/tomli ]]; then
		step "fetching tomli (pinned in packages/tomli-bin/PKGBUILD)"
		fetch_tomli >/dev/null
	fi
	PATH=$CACHE/bin:$PATH
}

# all strings of an array key, one per line (empty if the key is missing)
tlist() { { tomli query -f "$1" "$2" 2>/dev/null || true; } | { grep -o '"[^"]*"' || true; } | sed 's/^"//; s/"$//'; }

# one string value (quotes and tomli's leading space removed)
tstr() { local v; v=$(tomli query -f "$1" "$2" 2>/dev/null) || return 1; v=${v# }; v=${v#\"}; v=${v%\"}; printf '%s\n' "$v"; }
tcfg() { tstr "$PROFILE_TOML" "machine.$1" || die "missing [machine] $1 in $PROFILE_TOML"; }

# rewrite `key = [...]` inside [table] ("" = top level) with the contents of blockfile
awk_replace() { # file table key blockfile
	awk -v table="$2" -v key="$3" -v blk="$4" '
		BEGIN { intable = (table == "") }
		skip { if ($0 ~ /\]/) skip = 0; next }
		/^[ \t]*\[[^]]+\][ \t]*(#.*)?$/ {
			t = $0; sub(/^[ \t]*\[/, "", t); sub(/\][ \t]*(#.*)?$/, "", t); intable = (t == table)
		}
		intable && !done && $0 ~ ("^[ \t]*" key "[ \t]*=[ \t]*\\[") {
			while ((getline l < blk) > 0) print l
			close(blk); done = 1
			if ($0 !~ /\]/) skip = 1
			next
		}
		{ print }
		END { exit done ? 0 : 3 }
	' "$1"
}

# ---------------------------------------------------------------- repo

load_repo() {
	[[ -d $DSAM_DIR/packages ]] || die "not a dsam repo: $DSAM_DIR (set DSAM_DIR)"
	BASE_TOML=$DSAM_DIR/base.toml
	[[ -r $BASE_TOML ]] || die "missing $BASE_TOML"
	[[ -r /etc/dsam/profile ]] || die "no active profile: write its name to /etc/dsam/profile"
	PROFILE=$(tr -d '[:space:]' </etc/dsam/profile)
	PROFILE_TOML=$DSAM_DIR/profiles/$PROFILE/profile.toml
	[[ -r $PROFILE_TOML ]] || die "missing $PROFILE_TOML"
	ensure_tomli
}

# base.toml minus the profile's [packages] exclude
base_list() { tlist "$BASE_TOML" packages | { grep -vxFf <(tlist "$PROFILE_TOML" packages.exclude) || true; }; }

check_exclude() {
	local x
	while read -r x; do
		[[ -n $x ]] || continue
		tlist "$BASE_TOML" packages | has "$x" || warn "exclude \"$x\" is not in base.toml"
	done < <(tlist "$PROFILE_TOML" packages.exclude)
	return 0
}

# effective declared set: (base.toml - exclude) + list
declared_raw() { base_list; tlist "$PROFILE_TOML" packages.list; }

# declared names with groups expanded to their members, sorted
declared() {
	local x m
	while read -r x; do
		[[ -n $x ]] || continue
		m=$(pacman -Sgq "$x" 2>/dev/null || true)
		if [[ -n $m ]]; then printf '%s\n' "$m"; else printf '%s\n' "$x"; fi
	done < <(declared_raw) | sort -u
}

add_declared() {
	local p=$1 blk tmp
	if declared_raw | has "$p"; then return 0; fi
	if ((DRY)); then msg "[dry] would add $p to $PROFILE_TOML"; return 0; fi
	blk=$(mktemp) tmp=$(mktemp)
	{ tlist "$PROFILE_TOML" packages.list; printf '%s\n' "$p"; } | sort -u |
		awk 'BEGIN { print "list = [" } { printf "  \"%s\",\n", $0 } END { print "]" }' >"$blk"
	awk_replace "$PROFILE_TOML" packages list "$blk" >"$tmp" ||
		{ rm -f "$blk" "$tmp"; die "cannot record $p: no [packages] list = [...] in $PROFILE_TOML"; }
	if ! tlist "$tmp" packages.list | has "$p"; then
		rm -f "$blk" "$tmp"
		die "refusing to write $PROFILE_TOML: result failed verification"
	fi
	cat "$tmp" >"$PROFILE_TOML"
	rm -f "$blk" "$tmp"
	msg "recorded $p in profile '$PROFILE'"
}

# ---------------------------------------------------------------- custom packages

is_custom() { [[ -f $DSAM_DIR/packages/$1/PKGBUILD ]]; }
inst_ver()  { pacman -Q "$1" 2>/dev/null | cut -d' ' -f2 || true; }

# [epoch:]pkgver-pkgrel of a custom package, or "?" for VCS packages (pkgver() function)

has_dir() { [[ -d $DSAM_DIR/packages/$1 ]]; }

# .SRCINFO is generated, never committed; paru's PKGBUILD repo and the version check read it
sync_srcinfo() {
	local d
	for d in "$DSAM_DIR"/packages/*/; do
		[[ -f ${d}PKGBUILD ]] || continue
		if [[ ! -f ${d}.SRCINFO || ${d}PKGBUILD -nt ${d}.SRCINFO ]]; then
			(cd "$d" && makepkg --printsrcinfo >.SRCINFO.new && mv .SRCINFO.new .SRCINFO)
		fi
	done
	return 0
}

# [epoch:]pkgver-pkgrel from .SRCINFO, or "?" for VCS packages (pkgver() function)
pb_ver() {
	local d=$DSAM_DIR/packages/$1
	if grep '^pkgver()' "$d/PKGBUILD" >/dev/null; then echo "?"; return 0; fi
	awk -F' = ' '/^\tepoch =/ { e = $2 } /^\tpkgver =/ { v = $2 } /^\tpkgrel =/ { r = $2 } END { print (e != "" ? e ":" : "") v "-" r }' "$d/.SRCINFO"
}


link_dotfiles() {
	local src=$DSAM_DIR/packages/$1/.dotfiles f dest want cur
	[[ -d $src ]] || return 0
	while IFS= read -r f; do
		dest=$HOME/$f want=$src/$f
		if [[ -L $dest ]]; then
			cur=$(readlink -- "$dest")
			[[ $cur == "$want" ]] && continue
			if [[ $cur == "$DSAM_DIR"/packages/* ]]; then run ln -sfn -- "$want" "$dest"; continue; fi
		fi
		if [[ -e $dest || -L $dest ]]; then
			warn "conflict, not overwriting: $dest"
			RC=1
			continue
		fi
		run mkdir -p "$(dirname "$dest")"
		run ln -s -- "$want" "$dest"
	done < <(cd "$src" && find . \( -type f -o -type l \) | sed 's|^\./||' | sort)
	return 0
}

post_install() {
	local d=$DSAM_DIR/packages/$1
	[[ -x $d/post-install.sh ]] || return 0
	step "$1: post-install.sh"
	(cd "$d" && run ./post-install.sh) || { warn "$1: post-install.sh failed"; RC=1; }
	return 0
}


sync_dir() { # name [installed-version-before]; the PKGBUILD is optional
	local p=$1 pre iv rv act=current ch=0
	pre=${2-$(inst_ver "$p")}
	iv=$(inst_ver "$p")
	if is_custom "$p"; then
		rv=$(pb_ver "$p")
		if [[ -z $iv ]]; then act=install
		elif [[ $rv == '?' ]]; then act=current
		else
			case $(vercmp "$rv" "$iv") in
				1) act=upgrade ;;
				0) act=current ;;
				*) act=downgrade ;;
			esac
		fi
		case $act in
			install | upgrade | downgrade)
				step "$p: $act ${iv:+$iv -> }$rv"
				run aur -Bi "$DSAM_DIR/packages/$p"
				;;
			current) msg "$p: up to date (${iv:-?})" ;;
		esac
	fi
	link_dotfiles "$p"
	if ((DRY)); then
		if [[ $act != current || -z $pre ]]; then ch=1; fi
	elif [[ $(inst_ver "$p") != "$pre" ]]; then
		ch=1
	fi
	if ((ch)); then post_install "$p"; fi
	return 0
}


installed_dirs() {
	local d p
	for d in "$DSAM_DIR"/packages/*/; do
		[[ -d $d ]] || continue
		p=${d%/}; p=${p##*/}
		if [[ -n $(inst_ver "$p") ]]; then printf '%s\n' "$p"; fi
	done
}

# ---------------------------------------------------------------- commands


cmd_install() {
	load_repo; need paru pacman vercmp makepkg doas; sync_srcinfo
	local pkgs=("$@") p pre
	if ((${#pkgs[@]} == 0)); then
		mapfile -t pkgs < <(comm -23 <(declared) <(pacman -Qq | sort -u))
		if ((${#pkgs[@]} == 0)); then msg "nothing to install: every declared package is present"; return 0; fi
	fi
	for p in "${pkgs[@]}"; do
		pre=$(inst_ver "$p")
		if is_custom "$p"; then
			sync_dir "$p" "$pre"
		else
			step "$p"
			run aur -S --needed "$p"
			if has_dir "$p"; then sync_dir "$p" "$pre"; fi
		fi
		if ((DRY)); then
			add_declared "$p"
		elif pacman -Qq "$p" >/dev/null 2>&1 || [[ -n $(pacman -Qqg "$p" 2>/dev/null || true) ]]; then
			add_declared "$p"
			if pacman -Qdq -- "$p" >/dev/null 2>&1; then doas pacman -D --asexplicit -- "$p" >/dev/null; fi
		else
			warn "$p is not an installed package name; not recorded in the profile"
		fi
	done
	return "$RC"
}


cmd_update() {
	load_repo; need paru pacman vercmp makepkg; sync_srcinfo
	local ign p args=() customs=()
	declare -A pre=()
	ign=$(tlist "$PROFILE_TOML" packages.ignore | paste -sd,)
	if [[ -n $ign ]]; then args=(--ignore "$ign"); fi
	mapfile -t customs < <(installed_dirs)
	for p in "${customs[@]}"; do pre[$p]=$(inst_ver "$p"); done
	step "paru -Syu${ign:+ (ignoring $ign)}"
	run aur -Syu "${args[@]}"
	for p in "${customs[@]}"; do sync_dir "$p" "${pre[$p]}"; done
	return "$RC"
}


cmd_config() {
	load_repo; need pacman
	local p s
	while read -r p; do
		[[ -n $p ]] || continue
		link_dotfiles "$p"
	done < <(installed_dirs)
	while read -r s; do
		[[ -n $s ]] || continue
		case $s in
			user:*)
				s=${s#user:}
				if systemctl --user is-enabled --quiet "$s" 2>/dev/null; then
					msg "user service $s: enabled"
				else
					step "user service $s: enable"
					run systemctl --user enable "$s"
				fi ;;
			*)
				if systemctl is-enabled --quiet "$s" 2>/dev/null && systemctl is-active --quiet "$s" 2>/dev/null; then
					msg "service $s: enabled and active"
				else
					need doas systemctl
					step "service $s: enable --now"
					run doas systemctl enable --now "$s"
				fi ;;
		esac
	done < <(tlist "$PROFILE_TOML" services.enable)
	return "$RC"
}

sect() { # title, newline-separated names
	[[ -n $2 ]] || return 0
	printf '%s%s%s\n' "$H1" "$1" "$H0"
	sed 's/^/  /' <<<"$2"
	DIFF_RC=1
}

cmd_diff() {
	local deps=0 dec inst expl miss extra asdep orph stray="" clo x
	if [[ ${1-} == --deps ]]; then deps=1; elif (($# > 0)); then die "usage: dsam diff [--deps]"; fi
	load_repo; need pacman
	check_exclude
	dec=$(declared)
	inst=$(pacman -Qq | sort -u)
	expl=$({ pacman -Qqe || true; } | sort -u)
	miss=$(comm -23 <(lines "$dec") <(lines "$inst"))
	extra=$(comm -13 <(lines "$dec") <(lines "$expl"))
	asdep=$(comm -12 <(lines "$dec") <({ pacman -Qqd || true; } | sort -u))
	orph=$({ pacman -Qqdtt || true; } | sort -u)
	if ((deps)); then
		need pactree
		clo=$(comm -12 <(lines "$dec") <(lines "$inst") |
			while read -r x; do pactree -u "$x" 2>/dev/null || true; done | sort -u)
		stray=$(comm -23 <({ pacman -Qqd || true; } | sort -u) <(lines "$clo") | comm -23 - <(lines "$orph"))
	fi
	sect "missing (declared, not installed)" "$miss"
	sect "extra (explicitly installed, not declared)" "$extra"
	sect "declared but installed as dependency (pacman -D --asexplicit)" "$asdep"
	sect "orphans (dependencies nothing requires)" "$orph"
	sect "stray dependencies (not required by any declared package)" "$stray"
	if ((DIFF_RC)); then return 1; fi
	printf 'in sync (%s declared packages)\n' "$(lines "$dec" | wc -l)"
}

info_pkg() {
	local p=$1 v cls src req
	v=$(inst_ver "$p")
	printf 'package:   %s\n' "$p"
	if [[ -z $v ]]; then
		printf 'installed: no\n'
		if declared_raw | has "$p"; then printf 'declared:  yes\n'; else printf 'declared:  no\n'; fi
		if is_custom "$p"; then printf 'source:    custom (packages/%s)\n' "$p"; fi
		return 0
	fi
	if base_list | has "$p"; then cls="first-class (base)"
	elif tlist "$PROFILE_TOML" packages.list | has "$p"; then cls="first-class (profile $PROFILE)"
	elif tlist "$PROFILE_TOML" packages.exclude | has "$p"; then cls="undeclared (excluded from base by profile $PROFILE)"
	elif { pacman -Qqd || true; } | has "$p"; then cls="second-class (installed as dependency)"
	else cls="undeclared (explicitly installed)"; fi
	if is_custom "$p"; then src="custom (packages/$p)"
	elif { pacman -Qqn || true; } | has "$p"; then src="repository"
	else src="foreign (AUR or other)"; fi
	req=$(pacman -Qi "$p" | sed -n 's/^Required By *: *//p')
	printf 'version:   %s\nclass:     %s\nsource:    %s\nrequired by: %s\n' "$v" "$cls" "$src" "$req"
}

info_path() {
	local p link own pkg kind
	p=$(realpath -ms -- "$1")
	printf 'path:      %s\n' "$p"
	if [[ -L $p ]]; then
		link=$(readlink -f -- "$p")
		case $link in
			"$DSAM_DIR"/packages/*/.dotfiles/*)
				pkg=${link#"$DSAM_DIR"/packages/}; pkg=${pkg%%/*}
				printf 'type:      dotfile\nowner:     %s (dsam package directory, symlinked)\n' "$pkg"
				return 0 ;;
		esac
	fi
	if own=$(pacman -Qo -- "$p" 2>/dev/null); then
		printf 'type:      package-owned\nowner:     %s\n' "${own##* is owned by }"
		return 0
	fi
	case $p in
		/etc/* | "$HOME"/.config/*) kind=config ;;
		"$HOME"/*) kind="user data" ;;
		*) kind="system file" ;;
	esac
	printf 'type:      %s\nowner:     none (not owned by any package)\n' "$kind"
}

cmd_info() {
	(($# == 1)) || die "usage: dsam info <package|path>"
	load_repo; need pacman
	case $1 in
		*/* | .*) info_path "$1" ;;
		*) info_pkg "$1" ;;
	esac
}

# ---------------------------------------------------------------- base / setup

cmd_base() { # dsam base <profile> <disk>: ISO phase, root
	(($# == 2)) || die "usage: dsam base <profile> <disk>"
	local profile=$1 disk=$2 host tz loc swap esp rootsz username answer p x
	local swap_part="" home_part esp_part root_part swap_uuid="" root_uuid ram_mib
	local extra=() pkgs=()
	[[ -d /run/archiso ]] || die "base must be run from the Arch ISO"
	((EUID == 0)) || die "base must run as root"
	[[ -d /sys/firmware/efi ]] || die "UEFI required"
	[[ -b $disk ]] || die "not a block device: $disk"
	need sgdisk pacstrap arch-chroot genfstab mkfs.fat mkfs.ext4 lsblk blkid partprobe
	BASE_TOML=$DSAM_DIR/base.toml PROFILE=$profile PROFILE_TOML=$DSAM_DIR/profiles/$profile/profile.toml
	[[ -r $BASE_TOML ]] || die "missing $BASE_TOML"
	[[ -r $PROFILE_TOML ]] || die "unknown profile: $profile"
	ensure_tomli
	check_exclude
	host=$(tcfg host_name)
	tz=$(tcfg timezone)
	loc=$(tcfg locale)
	swap=$(tcfg swap)
	esp=$(tcfg esp_size)
	rootsz=$(tcfg root_size)
	case $swap in none | zram | hibernate) ;; *) die "bad [machine] swap: $swap" ;; esac

	lsblk -o NAME,SIZE,MODEL,MOUNTPOINTS "$disk"
	read -r -p "This ERASES $disk. Type the device path to continue: " answer
	[[ $answer == "$disk" ]] || die "aborted"
	read -r -p "Username: " username
	[[ $username =~ ^[a-z_][a-z0-9_-]*$ ]] || die "invalid username: $username"

	case $disk in *[0-9]) p=${disk}p ;; *) p=$disk ;; esac
	swapoff -a
	umount -R /mnt 2>/dev/null || true
	wipefs -af "$disk"
	sgdisk --zap-all "$disk"
	sgdisk -n "1:0:+$esp" -t 1:ef00 -c 1:esp "$disk"
	sgdisk -n "2:0:+$rootsz" -t 2:8304 -c 2:root "$disk"
	if [[ $swap == hibernate ]]; then
		ram_mib=$(awk '/^MemTotal:/ { print int(($2 + 1023) / 1024) }' /proc/meminfo)
		sgdisk -n "3:0:+${ram_mib}M" -t 3:8200 -c 3:swap "$disk"
		sgdisk -n 4:0:0 -t 4:8302 -c 4:home "$disk"
		swap_part=${p}3
		home_part=${p}4
	else
		sgdisk -n 3:0:0 -t 3:8302 -c 3:home "$disk"
		home_part=${p}3
	fi
	esp_part=${p}1
	root_part=${p}2
	partprobe "$disk"
	udevadm settle

	mkfs.fat -F32 -n ESP "$esp_part"
	mkfs.ext4 -F -L root "$root_part"
	mkfs.ext4 -F -L home "$home_part"
	mount "$root_part" /mnt
	mkdir -p /mnt/boot /mnt/home
	mount -o umask=0077 "$esp_part" /mnt/boot
	mount "$home_part" /mnt/home
	if [[ $swap == hibernate ]]; then
		mkswap -L swap "$swap_part"
		swapon "$swap_part"
		swap_uuid=$(blkid -s UUID -o value "$swap_part")
	fi
	root_uuid=$(blkid -s UUID -o value "$root_part")

	case $(awk -F': ' '/^vendor_id/ { print $2; exit }' /proc/cpuinfo) in
		GenuineIntel) extra+=(intel-ucode) ;;
		AuthenticAMD) extra+=(amd-ucode) ;;
	esac
	if [[ $swap == zram ]]; then extra+=(zram-generator); fi
	while read -r x; do
		[[ -n $x ]] || continue
		[[ -f $DSAM_DIR/packages/$x/PKGBUILD ]] || pkgs+=("$x") # custom packages come later, via dsam install
	done < <(base_list)

	pacstrap -K /mnt "${pkgs[@]}" "${extra[@]}"
	genfstab -U /mnt >/mnt/etc/fstab
	install -m 0755 "$SELF" /mnt/root/dsam-chroot
	arch-chroot /mnt /root/dsam-chroot _chroot "$host" "$tz" "$loc" "$swap" "$root_uuid" "$swap_uuid" "$username"
	rm /mnt/root/dsam-chroot
	mkdir -p /mnt/etc/dsam
	printf '%s\n' "$profile" >/mnt/etc/dsam/profile
	cp -a "$DSAM_DIR" "/mnt/home/$username/dsam"
	arch-chroot /mnt chown -R "$username:" "/home/$username/dsam"
	ln -sf "/home/$username/dsam/dsam" /mnt/usr/local/bin/dsam
	swapoff -a
	umount -R /mnt
	msg "Done. Reboot into the new system, connect to the network and run: dsam setup"
}

cmd_chroot() { # hidden: runs inside arch-chroot
	(($# == 7)) || die "internal command: dsam _chroot host tz locale swap root_uuid swap_uuid user"
	local host=$1 tz=$2 loc=$3 swap=$4 root_uuid=$5 swap_uuid=$6 user=$7 options
	ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime
	hwclock --systohc || warn "no hardware clock, skipping"
	sed -i "s/^#\($loc UTF-8\)/\1/" /etc/locale.gen
	locale-gen
	printf 'LANG=%s\n' "$loc" >/etc/locale.conf
	printf '%s\n' "$host" >/etc/hostname
	if [[ $swap == hibernate ]]; then
		mkdir -p /etc/mkinitcpio.conf.d
		cat >/etc/mkinitcpio.conf.d/dsam.conf <<'EOF'
HOOKS=(base udev resume autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck)
EOF
	fi
	if [[ $swap == zram ]]; then
		cat >/etc/systemd/zram-generator.conf <<'EOF'
[zram0]
zram-size = min(ram / 2, 4096)
EOF
	fi
	mkinitcpio -P
	bootctl install
	mkdir -p /boot/loader/entries
	cat >/boot/loader/loader.conf <<'EOF'
default arch.conf
timeout 3
editor no
EOF
	options="root=UUID=$root_uuid rw"
	if [[ -n $swap_uuid ]]; then options="$options resume=UUID=$swap_uuid"; fi
	printf 'title Arch Linux\nlinux /vmlinuz-linux\ninitrd /initramfs-linux.img\noptions %s\n' "$options" >/boot/loader/entries/arch.conf
	printf 'permit persist :wheel\n' >/etc/doas.conf
	chmod 0400 /etc/doas.conf
	doas -C /etc/doas.conf
	useradd -m -G wheel "$user"
	until passwd "$user"; do :; done
	passwd -l root
	systemctl enable NetworkManager systemd-timesyncd fstrim.timer systemd-boot-update.service
}

cmd_setup() { # dsam setup [profile]: first boot, or an already running Arch system
	local profile=${1-} p build need_pkgs=()
	[[ -f /etc/arch-release ]] || die "not Arch Linux"
	need doas git makepkg
	doas true || die "doas refused"
	if [[ -z $profile ]]; then profile=$(cat /etc/dsam/profile 2>/dev/null || true); fi
	[[ -n $profile ]] || die "usage: dsam setup <profile>"
	[[ -f $DSAM_DIR/profiles/$profile/profile.toml ]] || die "unknown profile: $profile"
	if [[ $(cat /etc/dsam/profile 2>/dev/null || true) != "$profile" ]]; then
		doas mkdir -p /etc/dsam
		printf '%s\n' "$profile" | doas tee /etc/dsam/profile >/dev/null
	fi
	if [[ ! -e /usr/local/bin/dsam ]]; then doas ln -s "$SELF" /usr/local/bin/dsam; fi

	step "prerequisites"
	for p in git base-devel; do
		pacman -Qq "$p" >/dev/null 2>&1 || need_pkgs+=("$p")
	done
	if ((${#need_pkgs[@]})); then doas pacman -S --needed --noconfirm "${need_pkgs[@]}"; fi
	if ! command -v paru >/dev/null 2>&1; then
		step "building paru"
		build=$CACHE/build
		rm -rf "$build"
		mkdir -p "$build"
		git clone --depth 1 https://aur.archlinux.org/paru.git "$build/paru"
		printf '. /etc/makepkg.conf\nPACMAN_AUTH=(doas)\n' >"$build/makepkg.conf"
		(cd "$build/paru" && makepkg --config "$build/makepkg.conf" -s --noconfirm)
		doas pacman -U --noconfirm "$build"/paru/paru-[0-9]*.pkg.tar.*
		rm -rf "$build"
	fi
	link_dotfiles paru
	if [[ $DSAM_DIR != "$HOME/dsam" ]]; then warn "repo is not at ~/dsam, so paru.conf's Path will not find packages/"; fi

	step "packages"
	cmd_install
	step "config"
	cmd_config
	step "drift report"
	cmd_diff || RC=1
	return "$RC"
}

# ---------------------------------------------------------------- help

topics() { roff | awk '/^\.SH/ { s = $0; sub(/^\.SH +/, "", s); gsub(/"/, "", s); print tolower(s) }'; }

usage() {
	cat <<EOF
dsam $VERSION: DSam system manager

usage: dsam [-n] <command> [args]
  base <profile> <disk>  ISO phase (root): partition, pacstrap, bootloader, user
  setup [profile]        first boot: build paru, then install + config + diff
  install [pkg...]   install packages; no args: everything declared but missing
  update             paru -Syu, then reconcile custom packages
  config             link dotfiles of custom packages, enable services
  diff [--deps]      declared vs installed packages (exit 1 if they differ)
  info <pkg|path>    class and source of a package, or the owner of a path
  fetch-tomli        download the pinned tomli binary and print its path
  man [--install]    full manual (--install writes dsam(1) system-wide)
  help [topic]       one manual section: $(topics | paste -sd' ')
  -n, --dry-run      show what install/update/config would do
EOF
}

cmd_help() {
	if (($# == 0)); then usage; return 0; fi
	need man
	local f
	f=$(mktemp)
	roff | awk -v t="${1^^}" '
		/^\.TH/ { print; next }
		/^\.SH/ { s = $0; sub(/^\.SH +/, "", s); gsub(/"/, "", s); on = (toupper(s) == t) }
		on { print; found = 1 }
		END { exit !found }
	' >"$f" || { rm -f "$f"; die "no such topic: $1 (topics: $(topics | paste -sd' '))"; }
	man -l "$f"
	rm -f "$f"
}

cmd_man() {
	need man
	local f
	f=$(mktemp)
	roff >"$f"
	if [[ ${1-} == --install ]]; then
		need doas install
		run doas install -Dm644 "$f" /usr/share/man/man1/dsam.1
	else
		man -l "$f"
	fi
	rm -f "$f"
}

roff() {
	cat <<'ROFF'
.TH DSAM 1 "2026-10" "dsam 1.0.0" "DSam"
.SH NAME
dsam \- DSam system manager: declared packages, custom PKGBUILDs, dotfiles, services
.SH SYNOPSIS
.nf
\fBdsam\fR \fBbase\fR \fIprofile\fR \fIdisk\fR
\fBdsam\fR \fBsetup\fR [\fIprofile\fR]
\fBdsam\fR [\fB\-n\fR] \fBinstall\fR [\fIpackage\fR...]
\fBdsam\fR [\fB\-n\fR] \fBupdate\fR
\fBdsam\fR [\fB\-n\fR] \fBconfig\fR
\fBdsam\fR \fBdiff\fR [\fB\-\-deps\fR]
\fBdsam\fR \fBinfo\fR \fIpackage\fR|\fIpath\fR
\fBdsam\fR \fBhelp\fR [\fItopic\fR]   \fBdsam\fR \fBman\fR [\fB\-\-install\fR]   \fBdsam\fR \fBfetch\-tomli\fR
.fi
.SH DESCRIPTION
dsam is the whole DSam implementation in one script: it installs the base system from the Arch ISO (\fBbase\fR), bootstraps the first boot (\fBsetup\fR) and keeps the system in line with two TOML files kept in a git repository: a base package list and a per\-machine profile.
It does not reimplement anything: packages go through \fBparu\fR(8), dotfiles through plain per\-file symlinks, services through \fBsystemctl\fR(1), TOML through \fBtomli\fR.
Apart from \fBbase\fR, it never edits /etc (it only enables services, writes /etc/dsam/profile in \fBsetup\fR and, optionally, installs the man page).
Run it as your normal user; it calls \fBdoas\fR where root is needed and refuses to run as root or under sudo/doas.
.PP
Terms: a \fIfirst\-class\fR package is one you listed (base.toml or the profile). A \fIsecond\-class\fR package is a dependency pulled in by something else.
A \fIpackage directory\fR is packages/<name>/; it may hold a PKGBUILD (a \fIcustom\fR package), a .dotfiles tree, a post\-install.sh, or any combination. A directory without a PKGBUILD only adds dotfiles and the hook to a package that comes from the repositories or the AUR.
.SH COMMANDS
.TP
.B base profile disk
Run from the Arch ISO, as root, from a clone of the repository. Reads [machine] from the profile, asks you to type the device path to confirm erasing it, asks for a username, then partitions (ESP, root, optional swap, /home taking the rest), formats, runs pacstrap with base.toml (packages that have a PKGBUILD are skipped; they are installed later), and runs the chroot stage (time zone, locale, hostname, initramfs, systemd\-boot, doas, the user and its password, locked root, NetworkManager and friends). It finally copies the repository to ~/dsam of the new user, writes /etc/dsam/profile and links dsam into /usr/local/bin.
.TP
.B setup [profile]
First boot, or an already running Arch system. Records the profile in /etc/dsam/profile, installs git and base\-devel, builds paru from the AUR (using doas), links the paru package's dotfiles, then runs \fBinstall\fR, \fBconfig\fR and \fBdiff\fR. Safe to rerun.
.TP
.B install [package...]
For each package: if packages/<name>/PKGBUILD exists it is a custom package, otherwise it is passed to paru (repositories and AUR).
After a successful install the name is added, sorted and deduplicated, to \fB[packages] list\fR of the active profile.
With no arguments, installs everything declared but missing (use this on a fresh system).
.TP
.B update
Runs \fBparu \-Syu\fR with the profile's \fB[packages] ignore\fR list, then reconciles every installed custom package: version change since before the update triggers post\-install.sh, a PKGBUILD older than the installed version is installed explicitly (downgrade), dotfiles are relinked.
.TP
.B config
Relinks the dotfiles of every installed package directory and enables (\fBsystemctl enable \-\-now\fR) each unit in \fB[services] enable\fR that is not already enabled and active. Entries prefixed with \fBuser:\fR are user units and are only enabled (\fBsystemctl \-\-user enable\fR).
.TP
.B diff [\-\-deps]
Compares what is installed with what is declared. See \fBDIFF\fR. Exit status 1 when anything differs.
.TP
.B info package
Version, class (base, profile, dependency, undeclared), source (custom, repository, foreign) and what requires it.
.TP
.B info path
Which package owns the file (\fBpacman \-Qo\fR). Paths symlinked from a package directory report that package. A path is anything containing a slash or starting with a dot.
.TP
.B fetch\-tomli
Downloads the tomli release pinned in packages/tomli\-bin/PKGBUILD, verifies its sha256, stores it in the cache directory and prints its path. Allowed as root so that base.sh can use it. Other commands do this automatically when tomli is not in PATH.
.TP
.B \-n, \-\-dry\-run
For install, update and config: print the commands that would run (paru, doas, symlinks, post\-install.sh) without running them or editing any file.
.SH INSTALL
.nf
1. Boot the Arch ISO, get network, clone the repository (git is on the ISO).
2. ./dsam base laptop /dev/nvme0n1       # confirm the device, pick a user
3. Reboot, log in, connect (nmtui), then:   dsam setup
4. From now on: dsam install | update | config | diff | info
.fi
.SH LAYOUT
.nf
/etc/dsam/profile                 one line: the active profile name
$DSAM_DIR/base.toml               packages every machine gets
$DSAM_DIR/profiles/<name>/profile.toml
$DSAM_DIR/packages/<name>/PKGBUILD         custom package (required)
$DSAM_DIR/packages/<name>/post\-install.sh  optional
$DSAM_DIR/packages/<name>/.dotfiles/       optional, mirrors $HOME
.fi
.SH TOML
dsam reads TOML with \fBtomli query\fR. Write strings with double quotes. The only file dsam writes is profile.toml, and only the \fBlist\fR array (rewritten one element per line, sorted; comments inside that array are lost). The result is re\-parsed before it replaces the file.
.PP
base.toml:
.nf
packages = [
  "base",
  "linux",
  "base\-devel",   # groups are expanded to their members
]
.fi
.PP
profiles/<name>/profile.toml:
.nf
[machine]            # read by \fBdsam base\fR only
host_name = "dsaml"
timezone = "Asia/Tehran"
locale = "en_US.UTF\-8"
swap = "hibernate"   # none, zram or hibernate
esp_size = "1G"
root_size = "80G"

[packages]
list = [
  "helix",
]
exclude = ["helix"]            # base.toml packages this profile does not want
ignore = ["linux\-firmware"]   # passed to paru \-Syu \-\-ignore

[services]
enable = ["NetworkManager.service", "user:foo.service"]
.fi
.PP
The declared set of a profile is \fB(base.toml \- exclude) + list\fR: \fBexclude\fR drops base packages this profile does not want (\fBbase\fR skips them in pacstrap; \fBdiff\fR then reports them as extra if they are installed), \fBlist\fR adds packages, and a name in both stays declared. Excluding a name that is not in base.toml only warns. Keys that are absent count as empty. \fBlist\fR must exist for \fBinstall\fR to record packages. \fB[machine]\fR is read only by \fBbase\fR: sizes are sgdisk sizes, /home takes the rest of the disk, and \fBhibernate\fR adds a swap partition the size of RAM plus a resume= kernel option.
.SH PACKAGES
.SS Creating a package
.nf
mkdir $DSAM_DIR/packages/foo
$EDITOR $DSAM_DIR/packages/foo/PKGBUILD   # pkgname must equal the directory name
dsam install foo
.fi
dsam generates .SRCINFO next to each PKGBUILD (never commit it) and installs with \fBparu \-\-sudo doas \-Bi packages/foo\fR, so paru resolves dependencies, including AUR ones. For \fBparu \-Syu\fR to also see custom packages, paru.conf needs a PKGBUILD repository section whose Path is $DSAM_DIR/packages; the paru package's dotfiles provide it. Without it \fBdsam update\fR still upgrades custom packages itself.
.PP
For \-bin packages: if upstream CI already builds a native .pkg.tar.zst, use it as the source and make package() copy usr/; otherwise download the release binary, verify its checksum and install it.
.SS Maintaining a package
Bump \fBpkgver\fR (reset \fBpkgrel\fR to 1) or \fBpkgrel\fR, update the checksums, run \fBdsam update\fR. dsam compares the PKGBUILD's [epoch:]pkgver\-pkgrel with the installed version using vercmp(8): higher means upgrade, lower means downgrade, equal means nothing. Lowering a version on purpose is how you roll back.
.PP
\fBpost\-install.sh\fR must be executable. It runs as your user, with the package directory as working directory, after an install, upgrade or downgrade of that package, never when the version is unchanged. Keep it idempotent.
.PP
VCS packages (a pkgver() function) have no version dsam can know without building; dsam leaves their upgrades to \fBparu \-Syu \-\-devel\fR and only relinks their dotfiles.
.SS Removing a package
Uninstall it (\fBparu \-Rns name\fR), delete its line from the profile list, and for a custom package delete its directory (delete its symlinks first: \fBfind ~ \-lname '$DSAM_DIR/packages/name/.dotfiles/*' \-delete\fR). dsam has no remove command on purpose.
.SH DOTFILES
Files under packages/<name>/.dotfiles/ mirror $HOME and are symlinked one by one (never whole directories), so programs writing next to their config do not write into the repository. Links that already point into the repository are refreshed. A real file or foreign link at a target is never overwritten: dsam warns, skips it and exits with status 1; move the file away (or into .dotfiles/) and rerun. \fBdsam \-n config\fR shows the links without making them.
.SH DIFF
No cache is kept; everything comes from pacman's local database.
.TP
.B missing
declared (groups expanded) but not installed.
.TP
.B extra
explicitly installed but not declared: either declare it or remove it.
.TP
.B declared but installed as dependency
fix with \fBpacman \-D \-\-asexplicit name\fR so removing its dependent does not remove it.
.TP
.B orphans
dependencies nothing requires (\fBpacman \-Qqdtt\fR).
.TP
.B stray dependencies
only with \fB\-\-deps\fR (needs pactree from pacman\-contrib): dependencies not reachable from any declared package, e.g. those pulled in by extras.
.PP
Files are deliberately out of scope: use \fBdsam info path\fR to ask who owns a file.
.SH ENVIRONMENT
.TP
.B DSAM_DIR
repository path (default: the directory of the dsam script if it contains packages/, otherwise ~/dsam).
.TP
.B XDG_CACHE_HOME
cache for the fetched tomli (~/.cache/dsam/bin).
.TP
.B NO_COLOR
disables colour. Colour is only used on terminals.
.SH CAVEATS
.IP \(bu 2
\fBbase\fR and \fB_chroot\fR are a line\-by\-line port of the former base.sh and post\-base.sh. Try them in a virtual machine after every change; they erase disks.
.IP \(bu 2
Downgrades are done with \fBparu \-Bi\fR (build, then pacman \-U) and have not been verified against every paru version; if \fBdsam update\fR reports a downgrade and the installed version does not change, run that command yourself and check the output.
.IP \(bu 2
Package directory name, pkgname and the name pacman knows must be identical.
.IP \(bu 2
Package names with provides (installing "jack" satisfied by another package) are not recorded in the profile; dsam warns.
.IP \(bu 2
tomli's command line is documented by its authors as unstable; the version and sha256 are pinned in packages/tomli\-bin/PKGBUILD, the single source for both the package and the bootstrap download.
.SH EXAMPLES
.nf
./dsam base laptop /dev/nvme0n1   # from the ISO
dsam setup                    # first boot
dsam install                  # install everything declared
dsam install helix ripgrep    # install and record in the profile
dsam \-n update                # preview an update
dsam diff \-\-deps              # what drifted?
dsam info ~/.cargo/config.toml
dsam info sway
dsam help packages            # just the PACKAGES section
.fi
.SH LICENSE
GPL\-3.0\-or\-later. Copyright (C) 2026 devssh. Files that state a different license in their header keep it.
ROFF
}

main() {
	local a args=()
	for a in "$@"; do
		case $a in
			-n | --dry-run) DRY=1 ;;
			*) args+=("$a") ;;
		esac
	done
	set -- "${args[@]}"
	local cmd=${1-help}
	shift || true
	case $cmd in
		help | -h | --help) cmd_help "$@" ;;
		man) cmd_man "$@" ;;
		version | -V | --version) echo "dsam $VERSION" ;;
		fetch-tomli) fetch_tomli ;;
		base) if ((DRY)); then die "-n is not supported for base"; fi; cmd_base "$@" ;;
		_chroot) cmd_chroot "$@" ;;
		setup) if ((DRY)); then die "-n is not supported for setup"; fi; guard; cmd_setup "$@" ;;
		install | update | config | diff | info) guard; "cmd_$cmd" "$@" ;;
		*) die "unknown command: $cmd (try: dsam help)" ;;
	esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
